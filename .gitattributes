# The map generator writes its outputs with explicit LF newlines. Git's
# core.autocrlf would otherwise check them back out as CRLF on Windows,
# so every `npm run generate-map` reported a diff on files whose content
# had not changed at all. Pin them to LF and the run is a true no-op
# when the terrain and nav graph are unchanged.
src/data/mapGeometry.js text eol=lf
src/data/mapTrails.js   text eol=lf
public/assets/contours.svg text eol=lf
